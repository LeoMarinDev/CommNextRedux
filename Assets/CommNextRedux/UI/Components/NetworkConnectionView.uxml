<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/CommNextStyles.uss?fileID=7433441132597879392&amp;guid=a2dd25c9df311c044b3d4c1d0b58a080&amp;type=3#CommNextStyles" />
    <!-- U6i: THE LONG-NAME ROW. The player's report: "If the vessel name is too long in the Vessel
         Comms report rows - the row UI and configuration gets really fucked up."

         The mechanism was three flex defaults and one missing bound. The row's name label carried no
         class and no elision, and every wrapper above it was `flex-shrink: 0` (the middle column and
         the space-between row below), so a long name grew the left group without bound: the label
         overran the row, pushed `#direction-tag` out of the viewport, and - because nothing clipped -
         painted past the row's rounded box and under the ScrollView's scrollbar.

         The fix is the header's own proven rule applied to the row, plus the chain that lets it
         work. `min-width: 0` on the column, on the space-between row and on the left group is
         load-bearing: a flex item's automatic minimum size is its content, so without it every
         wrapper refuses to shrink and the label never elides. The label itself is
         `class="connection-row__name"`, whose rule lives in CommNextStyles.uss and is scoped to
         `.row__container .connection-row__name` so the header's label (`vessel-report__name`) and the
         band rows' class-free `name-label` cannot be hit. `#direction-tag` is `flex-shrink: 0` in the
         sheet, and `.row__container` clips. -->
    <ui:VisualElement class="row__spacer" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0);">
        <ui:VisualElement name="row__container" class="row__container" style="flex-grow: 1; flex-direction: row; align-items: center; padding-left: 6px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px; flex-shrink: 0;">
            <ui:VisualElement style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); align-items: center;">
                <ui:VisualElement name="connection-icon" class="relay__icon" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0);" />
            </ui:VisualElement>
            <ui:VisualElement class="vertical-separator" style="flex-grow: 0; height: 100%;" />
            <ui:VisualElement style="flex-grow: 1; min-width: 0; background-color: rgba(0, 0, 0, 0); flex-shrink: 1;">
                <ui:VisualElement style="flex-grow: 1; min-width: 0; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 1;">
                    <ui:VisualElement style="flex-grow: 0; min-width: 0; background-color: rgba(0, 0, 0, 0); flex-direction: row; justify-content: flex-start; align-items: center; margin-left: 2px;">
                        <CommNext.Unity.Runtime.Controls.SignalStrengthIcon strength="Full" name="signal-strength-icon" style="margin-top: 0; justify-content: flex-start; align-self: center; margin-right: 3px; margin-bottom: 2px;" />
                        <CommNext.Unity.Runtime.Controls.BandIcon color="#B325D4FF" code="X" name="band-icon" style="margin-top: 0; margin-right: 2px;" />
                        <ui:Label tabindex="-1" text="Relay Name" display-tooltip-when-elided="true" name="name-label" class="connection-row__name" style="font-size: 13px;" />
                        <ui:VisualElement name="band-icon--old" class="band__icon" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); flex-shrink: 0; margin-left: 0; margin-top: 1px; display: none;" />
                        <ui:VisualElement name="power-icon" class="icon__small icon--no-power" style="flex-grow: 0; background-color: rgba(207, 79, 79, 0); background-image: url(&apos;project://database/Assets/Images/PowerIcon.png?fileID=21300000&amp;guid=c50a10f38dd04714b94be75e717f92de&amp;type=3#PowerIcon&apos;); border-top-left-radius: 3px; border-bottom-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; visibility: visible; display: flex;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="direction-tag" class="direction__tag--inbound direction__tag" style="background-color: rgb(36, 41, 51);">
                        <ui:Label tabindex="-1" text="In" display-tooltip-when-elided="true" name="direction-label" style="padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; font-size: 10px;" />
                        <ui:VisualElement name="direction-icon" class="icon__small" style="flex-grow: 0; background-color: rgba(0, 0, 0, 0); background-image: url(&apos;project://database/Assets/Images/ConnectRightIcon.png?fileID=21300000&amp;guid=2ceefa7e3f586bc4b83af51995713511&amp;type=3#ConnectRightIcon&apos;);" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label tabindex="-1" text="Distance: &lt;color=#E7CA76&gt;360Gm&lt;/color&gt;" display-tooltip-when-elided="true" name="details-label" style="font-size: 12px; color: rgb(114, 121, 135); padding-top: 0;" />
            </ui:VisualElement>
            <ui:Button text="Control" display-tooltip-when-elided="true" name="control-button" class="row__button--on-hover" style="position: absolute; right: 5px; padding-left: 5px; padding-right: 5px; padding-top: 2px; padding-bottom: 2px; font-size: 11px; height: 24px; bottom: 3px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
